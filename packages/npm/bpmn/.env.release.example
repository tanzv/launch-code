# Copy this file to .env.release.local and adjust values for your local publish target.
# The local file is loaded automatically by scripts/release_bpmn_package.sh.

LCODE_NPM_PUBLISH_REGISTRY=https://registry.npmjs.org
LCODE_NPM_PUBLISH_TAG=latest
LCODE_NPM_PUBLISH_ACCESS=public
# Set to true for safety checks before real publishing.
LCODE_NPM_PUBLISH_DRY_RUN=true

# Optional: default package version for the next release command.
# LCODE_NPM_BPMN_VERSION=0.1.1
